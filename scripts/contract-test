#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "$0")/.." && pwd)"
TMP_DIR="$(mktemp -d)"
DB_PATH="$TMP_DIR/otel.debug.sqlite"
LOG_PATH="$TMP_DIR/logal.log"
OTLP_GRPC_PORT="${LOGAL_TEST_OTLP_GRPC_PORT:-24317}"
OTLP_HTTP_PORT="${LOGAL_TEST_OTLP_HTTP_PORT:-${AUTOK_LOGAL_TEST_OTLP_PORT:-24318}}"
HEALTH_PORT="${LOGAL_TEST_HEALTH_PORT:-${AUTOK_LOGAL_TEST_HEALTH_PORT:-23133}}"
PID=""

fail() {
	echo "contract test failed: $*" >&2
	return 1
}

assert_eq() {
	local expected="$1"
	local actual="$2"
	local description="$3"
	if [[ "$actual" != "$expected" ]]; then
		fail "$description: expected '$expected', got '$actual'"
	fi
}

stop_process() {
	if [[ -z "$PID" ]]; then
		return
	fi
	if kill -0 "$PID" 2>/dev/null; then
		kill -INT "$PID" 2>/dev/null || true
		(
			sleep 5
			kill -KILL "$PID" 2>/dev/null || true
		) &
		local guard_pid=$!
		wait "$PID" 2>/dev/null || true
		kill "$guard_pid" 2>/dev/null || true
		wait "$guard_pid" 2>/dev/null || true
	else
		wait "$PID" 2>/dev/null || true
	fi
	PID=""
}

assert_graceful_shutdown() {
	local forced_marker="$TMP_DIR/forced-kill"
	local guard_pid
	local exit_status

	kill -INT "$PID" || fail "could not signal Logal for graceful shutdown"
	(
		sleep 5
		if kill -0 "$PID" 2>/dev/null; then
			touch "$forced_marker"
			kill -KILL "$PID" 2>/dev/null || true
		fi
	) &
	guard_pid=$!
	set +e
	wait "$PID"
	exit_status=$?
	set -e
	PID=""
	kill "$guard_pid" 2>/dev/null || true
	wait "$guard_pid" 2>/dev/null || true

	if [[ -e "$forced_marker" ]]; then
		fail "Logal did not stop within 5 seconds of SIGINT"
	fi
	assert_eq "0" "$exit_status" "graceful shutdown exit status"
}

cleanup() {
	local status=$?
	trap - EXIT
	stop_process
	if [[ "$status" -ne 0 && -f "$LOG_PATH" ]]; then
		echo "----- Logal contract-test output -----" >&2
		sed -n '1,240p' "$LOG_PATH" >&2
	fi
	rm -rf "$TMP_DIR"
	exit "$status"
}
trap cleanup EXIT

for command in curl lsof sqlite3; do
	command -v "$command" >/dev/null 2>&1 || fail "$command is required"
done
for port in "$OTLP_GRPC_PORT" "$OTLP_HTTP_PORT" "$HEALTH_PORT"; do
	pids="$(lsof -nP -t -iTCP:"$port" -sTCP:LISTEN 2>/dev/null || true)"
	if [[ -n "$pids" ]]; then
		fail "TCP port $port is already in use by PID(s): $pids"
	fi
done

cd "$ROOT_DIR"
go build -o "$TMP_DIR/logal" ./cmd/logal
LOGAL_DB_PATH="$DB_PATH" \
	LOGAL_RETENTION_HOURS=48 \
	LOGAL_OTLP_GRPC_ENDPOINT="127.0.0.1:$OTLP_GRPC_PORT" \
	LOGAL_OTLP_HTTP_ENDPOINT="127.0.0.1:$OTLP_HTTP_PORT" \
	LOGAL_HEALTH_ENDPOINT="127.0.0.1:$HEALTH_PORT" \
	LOGAL_MAX_IN_FLIGHT_REQUESTS=8 \
	"$TMP_DIR/logal" --config "$ROOT_DIR/config/local.yaml" >"$LOG_PATH" 2>&1 &
PID=$!

ready=false
deadline=$((SECONDS + 15))
while ((SECONDS < deadline)); do
	if ! kill -0 "$PID" 2>/dev/null; then
		wait "$PID" 2>/dev/null || true
		PID=""
		fail "Logal exited before readiness"
	fi
	if curl --connect-timeout 1 --max-time 2 -fsS "http://127.0.0.1:$HEALTH_PORT/readyz" >/dev/null 2>&1; then
		ready=true
		break
	fi
	sleep 0.1
done
[[ "$ready" == true ]] || fail "Logal did not become ready within 15 seconds"

for port in "$OTLP_GRPC_PORT" "$OTLP_HTTP_PORT" "$HEALTH_PORT"; do
	owner="$(lsof -nP -a -p "$PID" -t -iTCP:"$port" -sTCP:LISTEN 2>/dev/null || true)"
	assert_eq "$PID" "$owner" "Logal ownership of TCP port $port"
done

LOG_PAYLOAD='{"resourceLogs":[{"resource":{"attributes":[{"key":"service.name","value":{"stringValue":"contract"}}]},"scopeLogs":[{"logRecords":[{"severityNumber":9,"severityText":"INFO","body":{"kvlistValue":{"values":[{"key":"message","value":{"stringValue":"ready"}},{"key":"password","value":{"stringValue":"must-not-persist-body"}}]}},"attributes":[{"key":"authorization","value":{"stringValue":"Bearer must-not-persist"}},{"key":"event.name","value":{"stringValue":"contract.frontend.ready"}},{"key":"request.id","value":{"stringValue":"request-123"}},{"key":"autok.product.id","value":{"stringValue":"product-456"}},{"key":"app.component","value":{"stringValue":"frontend"}}]}]}]}]}'
for _ in 1 2; do
	curl --connect-timeout 1 --max-time 5 -fsS -X POST "http://127.0.0.1:$OTLP_HTTP_PORT/v1/logs" \
		-H 'Content-Type: application/json' \
		--data "$LOG_PAYLOAD" >/dev/null
done

curl --connect-timeout 1 --max-time 5 -fsS -X POST "http://127.0.0.1:$OTLP_HTTP_PORT/v1/traces" \
	-H 'Content-Type: application/json' \
	--data '{"resourceSpans":[{"resource":{"attributes":[{"key":"service.name","value":{"stringValue":"contract"}}]},"scopeSpans":[{"spans":[{"traceId":"00112233445566778899aabbccddeeff","spanId":"0011223344556677","name":"stable"}]}]}]}' >/dev/null

curl --connect-timeout 1 --max-time 5 -fsS -X POST "http://127.0.0.1:$OTLP_HTTP_PORT/v1/traces" \
	-H 'Content-Type: application/json' \
	--data '{"resourceSpans":[{"resource":{"attributes":[{"key":"service.name","value":{"stringValue":"contract"}}]},"scopeSpans":[{"spans":[{"traceId":"ffeeddccbbaa99887766554433221100","spanId":"7766554433221100","name":"other"},{"traceId":"00112233445566778899aabbccddeeff","spanId":"0011223344556677","name":"stable"}]}]}]}' >/dev/null
read -r -d '' METRICS_BASE <<'JSON' || true
{
  "resourceMetrics": [{
    "resource": {"attributes": [
      {"key": "service.name", "value": {"stringValue": "contract"}},
      {"key": "authorization", "value": {"stringValue": "Bearer metric-resource-secret"}}
    ]},
    "scopeMetrics": [{
      "scope": {"name": "contract.metrics", "attributes": [
        {"key": "password", "value": {"stringValue": "metric-scope-secret"}}
      ]},
      "metrics": [
        {
          "name": "contract.gauge",
          "unit": "1",
          "gauge": {"dataPoints": [{
            "startTimeUnixNano": "0",
            "timeUnixNano": "0",
            "asInt": "1",
            "flags": 1,
            "attributes": [
              {"key": "session_token", "value": {"stringValue": "metric-point-secret"}},
              {"key": "gen_ai.usage.input_tokens", "value": {"intValue": "123"}}
            ],
            "exemplars": [{
              "filteredAttributes": [{"key": "refresh_token", "value": {"stringValue": "metric-exemplar-secret"}}],
              "timeUnixNano": "0",
              "asDouble": 1.5,
              "traceId": "00112233445566778899aabbccddeeff",
              "spanId": "0011223344556677"
            }]
          }]}
        },
        {
          "name": "contract.sum",
          "sum": {
            "aggregationTemporality": 1,
            "isMonotonic": true,
            "dataPoints": [{"startTimeUnixNano": "10", "timeUnixNano": "20", "asInt": "7"}]
          }
        },
        {
          "name": "contract.histogram",
          "histogram": {
            "aggregationTemporality": 2,
            "dataPoints": [{
              "startTimeUnixNano": "10",
              "timeUnixNano": "20",
              "count": "3",
              "sum": 6,
              "min": 1,
              "max": 3,
              "explicitBounds": [1, 2],
              "bucketCounts": ["1", "1", "1"]
            }]
          }
        },
        {
          "name": "contract.exponential_histogram",
          "exponentialHistogram": {
            "aggregationTemporality": 2,
            "dataPoints": [{
              "startTimeUnixNano": "10",
              "timeUnixNano": "20",
              "count": "2",
              "sum": 3,
              "min": 1,
              "max": 2,
              "scale": 1,
              "zeroCount": "1",
              "zeroThreshold": 0.1,
              "positive": {"offset": -1, "bucketCounts": ["1"]},
              "negative": {"offset": 1, "bucketCounts": ["0"]}
            }]
          }
        },
        {
          "name": "contract.summary",
          "summary": {"dataPoints": [{
            "startTimeUnixNano": "10",
            "timeUnixNano": "20",
            "count": "2",
            "sum": 3,
            "quantileValues": [
              {"quantile": 0.5, "value": 1},
              {"quantile": 0.99, "value": 2}
            ]
          }]}
        }
      ]
    }]
  }]
}
JSON

read -r -d '' METRICS_OVERLAP <<'JSON' || true
{
  "resourceMetrics": [{
    "resource": {"attributes": [
      {"key": "service.name", "value": {"stringValue": "contract"}},
      {"key": "authorization", "value": {"stringValue": "Bearer metric-resource-secret"}}
    ]},
    "scopeMetrics": [{
      "scope": {"name": "contract.metrics", "attributes": [
        {"key": "password", "value": {"stringValue": "metric-scope-secret"}}
      ]},
      "metrics": [{
        "name": "contract.gauge",
        "unit": "1",
        "gauge": {"dataPoints": [
          {
            "startTimeUnixNano": "0",
            "timeUnixNano": "0",
            "asInt": "1",
            "flags": 1,
            "attributes": [
              {"key": "session_token", "value": {"stringValue": "metric-point-secret"}},
              {"key": "gen_ai.usage.input_tokens", "value": {"intValue": "123"}}
            ],
            "exemplars": [{
              "filteredAttributes": [{"key": "refresh_token", "value": {"stringValue": "metric-exemplar-secret"}}],
              "timeUnixNano": "0",
              "asDouble": 1.5,
              "traceId": "00112233445566778899aabbccddeeff",
              "spanId": "0011223344556677"
            }]
          },
          {
            "startTimeUnixNano": "0",
            "timeUnixNano": "0",
            "asInt": "2",
            "attributes": [{"key": "session_token", "value": {"stringValue": "metric-point-secret"}}]
          }
        ]}
      }]
    }]
  }]
}
JSON

for payload in "$METRICS_BASE" "$METRICS_BASE" "$METRICS_OVERLAP"; do
  curl --connect-timeout 1 --max-time 5 -fsS -X POST "http://127.0.0.1:$OTLP_HTTP_PORT/v1/metrics" \
    -H 'Content-Type: application/json' \
    --data "$payload" >/dev/null
done

curl --connect-timeout 1 --max-time 5 -fsS -X POST "http://127.0.0.1:$OTLP_HTTP_PORT/v1/metrics" \
	-H 'Content-Type: application/json' \
	--data '{"resourceMetrics":[{"resource":{"attributes":[{"key":"service.name","value":{"stringValue":"contract-cross"}}]},"scopeMetrics":[{"metrics":[{"name":"contract.cross.gauge","gauge":{"dataPoints":[{"timeUnixNano":"0","asInt":"1"}]}}]}]}]}' >/dev/null
go run ./internal/contractgrpc -endpoint "127.0.0.1:$OTLP_GRPC_PORT"

assert_eq "1" "$(sqlite3 -readonly "$DB_PATH" "SELECT COUNT(*) FROM otel_logs WHERE service_name='grpc-contract'")" "gRPC log ingestion"
assert_eq "1" "$(sqlite3 -readonly "$DB_PATH" "SELECT COUNT(*) FROM otel_spans WHERE service_name='grpc-contract'")" "gRPC trace ingestion"
assert_eq "1" "$(sqlite3 -readonly "$DB_PATH" "SELECT COUNT(*) FROM otel_metric_points WHERE service_name='grpc-contract' AND metric_name='grpc.contract.gauge'")" "gRPC metric ingestion"
assert_eq "1" "$(sqlite3 -readonly "$DB_PATH" "SELECT COUNT(*) FROM otel_metric_points WHERE service_name='contract-cross' AND metric_name='contract.cross.gauge'")" "cross-protocol metric deduplication"
assert_eq "6" "$(sqlite3 -readonly "$DB_PATH" "SELECT COUNT(*) FROM otel_metric_points WHERE service_name='contract'")" "metric deduplication"
assert_eq "5" "$(sqlite3 -readonly "$DB_PATH" "SELECT COUNT(DISTINCT metric_type) FROM otel_metric_points WHERE service_name='contract'")" "metric type coverage"
assert_eq "2" "$(sqlite3 -readonly "$DB_PATH" "SELECT COUNT(*) FROM otel_metric_points WHERE metric_name='contract.gauge' AND metric_type='gauge' AND number_kind='int' AND number_int IN (1,2) AND time_unix_nano=0")" "same-time metric preservation"
assert_eq "1" "$(sqlite3 -readonly "$DB_PATH" "SELECT COUNT(*) FROM otel_metric_points WHERE metric_name='contract.gauge' AND number_int=1")" "exact metric retry deduplication"
assert_eq "1" "$(sqlite3 -readonly "$DB_PATH" "SELECT COUNT(*) FROM otel_metric_points WHERE metric_name='contract.sum' AND metric_type='sum' AND number_kind='int' AND number_int=7")" "sum projection"
assert_eq "1" "$(sqlite3 -readonly "$DB_PATH" "SELECT COUNT(*) FROM otel_metric_points WHERE metric_name='contract.histogram' AND aggregate_count='3' AND aggregate_sum=6 AND aggregate_min=1 AND aggregate_max=3")" "histogram projection"
assert_eq "1" "$(sqlite3 -readonly "$DB_PATH" "SELECT COUNT(*) FROM otel_metric_points WHERE metric_name='contract.exponential_histogram' AND aggregate_count='2' AND aggregate_sum=3")" "exponential histogram projection"
assert_eq "1" "$(sqlite3 -readonly "$DB_PATH" "SELECT COUNT(*) FROM otel_metric_points WHERE metric_name='contract.summary' AND aggregate_count='2' AND aggregate_sum=3")" "summary projection"
assert_eq "1" "$(sqlite3 -readonly "$DB_PATH" "SELECT COUNT(*) FROM otel_metric_points WHERE metric_name='contract.histogram' AND json_array_length(json_extract(payload_json,'$.resourceMetrics[0].scopeMetrics[0].metrics[0].histogram.dataPoints[0].bucketCounts'))=3")" "histogram payload fidelity"
assert_eq "1" "$(sqlite3 -readonly "$DB_PATH" "SELECT COUNT(*) FROM otel_metric_points WHERE metric_name='contract.exponential_histogram' AND json_extract(payload_json,'$.resourceMetrics[0].scopeMetrics[0].metrics[0].exponentialHistogram.dataPoints[0].positive.offset')=-1")" "exponential histogram payload fidelity"
assert_eq "1" "$(sqlite3 -readonly "$DB_PATH" "SELECT COUNT(*) FROM otel_metric_points WHERE metric_name='contract.summary' AND json_array_length(json_extract(payload_json,'$.resourceMetrics[0].scopeMetrics[0].metrics[0].summary.dataPoints[0].quantileValues'))=2")" "summary payload fidelity"
assert_eq "1" "$(sqlite3 -readonly "$DB_PATH" "SELECT COUNT(*) FROM otel_metric_points WHERE metric_name='contract.gauge' AND json_extract(payload_json,'$.resourceMetrics[0].scopeMetrics[0].metrics[0].gauge.dataPoints[0].exemplars[0].traceId')='00112233445566778899aabbccddeeff'")" "exemplar correlation"
assert_eq "6" "$(sqlite3 -readonly "$DB_PATH" "SELECT COUNT(*) FROM otel_metric_points WHERE payload_json LIKE '%[REDACTED]%'")" "metric redaction markers"
assert_eq "0" "$(sqlite3 -readonly "$DB_PATH" "SELECT COUNT(*) FROM otel_metric_points WHERE payload_json LIKE '%metric-resource-secret%' OR payload_json LIKE '%metric-scope-secret%' OR payload_json LIKE '%metric-point-secret%' OR payload_json LIKE '%metric-exemplar-secret%'")" "metric credential redaction"
assert_eq "1" "$(sqlite3 -readonly "$DB_PATH" "SELECT COUNT(*) FROM otel_metric_points WHERE metric_name='contract.gauge' AND payload_json LIKE '%gen_ai.usage.input_tokens%' AND payload_json LIKE '%123%'")" "token count preservation"
STATUS_JSON="$(curl --connect-timeout 1 --max-time 5 -fsS "http://127.0.0.1:$HEALTH_PORT/status")"
[[ "$STATUS_JSON" == *'"committed_metric_points":8'* ]] || fail "status metric counter"

assert_eq "1" "$(sqlite3 -readonly "$DB_PATH" "SELECT COUNT(*) FROM otel_logs WHERE service_name='contract'")" "log deduplication"
assert_eq "0" "$(sqlite3 -readonly "$DB_PATH" "SELECT COUNT(*) FROM otel_logs WHERE payload_json LIKE '%must-not-persist%'")" "log payload redaction"
assert_eq "0" "$(sqlite3 -readonly "$DB_PATH" "SELECT COUNT(*) FROM otel_logs WHERE body_json LIKE '%must-not-persist%'")" "log body redaction"
assert_eq "1" "$(sqlite3 -readonly "$DB_PATH" "SELECT COUNT(*) FROM otel_logs WHERE payload_json LIKE '%[REDACTED]%'")" "redaction marker persistence"
assert_eq "1" "$(sqlite3 -readonly "$DB_PATH" "SELECT COUNT(*) FROM otel_logs WHERE op='contract.frontend.ready' AND request_id='request-123' AND product_id='product-456' AND component='frontend'")" "correlation field extraction"
assert_eq "2" "$(sqlite3 -readonly "$DB_PATH" "SELECT COUNT(*) FROM otel_spans WHERE service_name='contract'")" "span deduplication"


kill -0 "$PID" 2>/dev/null || fail "Logal exited before graceful shutdown"
assert_graceful_shutdown
