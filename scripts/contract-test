#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "$0")/.." && pwd)"
TMP_DIR="$(mktemp -d)"
DB_PATH="$TMP_DIR/otel.debug.sqlite"
OTLP_PORT="${AUTOK_LOGAL_TEST_OTLP_PORT:-24318}"
HEALTH_PORT="${AUTOK_LOGAL_TEST_HEALTH_PORT:-23133}"
PID=""

cleanup() {
  if [[ -n "$PID" ]] && kill -0 "$PID" 2>/dev/null; then
    kill -INT "$PID"
    wait "$PID"
  fi
  rm -rf "$TMP_DIR"
}
trap cleanup EXIT

cd "$ROOT_DIR"
go build -o "$TMP_DIR/logal" ./cmd/logal
AUTOK_LOGAL_DB_PATH="$DB_PATH" \
AUTOK_LOGAL_RETENTION_HOURS=48 \
AUTOK_LOGAL_OTLP_PORT="$OTLP_PORT" \
AUTOK_LOGAL_HEALTH_PORT="$HEALTH_PORT" \
  "$TMP_DIR/logal" --config "$ROOT_DIR/config/local.yaml" >"$TMP_DIR/logal.log" 2>&1 &
PID=$!

for _ in {1..100}; do
  if curl -fsS "http://127.0.0.1:$HEALTH_PORT/readyz" >/dev/null 2>&1; then
    break
  fi
  sleep 0.1
done
curl -fsS "http://127.0.0.1:$HEALTH_PORT/readyz" >/dev/null

curl -fsS -X POST "http://127.0.0.1:$OTLP_PORT/v1/logs" \
  -H 'Content-Type: application/json' \
  --data '{"resourceLogs":[{"resource":{"attributes":[{"key":"service.name","value":{"stringValue":"contract"}}]},"scopeLogs":[{"logRecords":[{"severityNumber":9,"severityText":"INFO","body":{"kvlistValue":{"values":[{"key":"message","value":{"stringValue":"ready"}},{"key":"password","value":{"stringValue":"must-not-persist-body"}}]}},"attributes":[{"key":"authorization","value":{"stringValue":"Bearer must-not-persist"}}]}]}]}]}' >/dev/null

curl -fsS -X POST "http://127.0.0.1:$OTLP_PORT/v1/traces" \
  -H 'Content-Type: application/json' \
  --data '{"resourceSpans":[{"resource":{"attributes":[{"key":"service.name","value":{"stringValue":"contract"}}]},"scopeSpans":[{"spans":[{"traceId":"00112233445566778899aabbccddeeff","spanId":"0011223344556677","name":"stable"}]}]}]}' >/dev/null

curl -fsS -X POST "http://127.0.0.1:$OTLP_PORT/v1/traces" \
  -H 'Content-Type: application/json' \
  --data '{"resourceSpans":[{"resource":{"attributes":[{"key":"service.name","value":{"stringValue":"contract"}}]},"scopeSpans":[{"spans":[{"traceId":"ffeeddccbbaa99887766554433221100","spanId":"7766554433221100","name":"other"},{"traceId":"00112233445566778899aabbccddeeff","spanId":"0011223344556677","name":"stable"}]}]}]}' >/dev/null

test "$(sqlite3 -readonly "$DB_PATH" "SELECT COUNT(*) FROM otel_logs WHERE service_name='contract'")" = "1"
test "$(sqlite3 -readonly "$DB_PATH" "SELECT COUNT(*) FROM otel_logs WHERE payload_json LIKE '%must-not-persist%'")" = "0"
test "$(sqlite3 -readonly "$DB_PATH" "SELECT COUNT(*) FROM otel_logs WHERE body_json LIKE '%must-not-persist%'")" = "0"
test "$(sqlite3 -readonly "$DB_PATH" "SELECT COUNT(*) FROM otel_logs WHERE payload_json LIKE '%[REDACTED]%'")" = "1"
test "$(sqlite3 -readonly "$DB_PATH" "SELECT COUNT(*) FROM otel_spans WHERE service_name='contract'")" = "2"
test "$(curl -sS -o /dev/null -w '%{http_code}' -X POST "http://127.0.0.1:$OTLP_PORT/v1/metrics" -H 'Content-Type: application/json' --data '{}')" = "404"

kill -INT "$PID"
wait "$PID"
PID=""
