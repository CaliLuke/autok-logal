#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "$0")/.." && pwd)"
AUTOK_ROOT="$(cd "$ROOT_DIR/.." && pwd)"
BINARY_PATH="${AUTOK_LOGAL_BINARY_PATH:-$ROOT_DIR/bin/logal}"
CONFIG_PATH="${AUTOK_LOGAL_CONFIG_PATH:-$ROOT_DIR/config/local.yaml}"

export AUTOK_LOGAL_DB_PATH="${AUTOK_LOGAL_DB_PATH:-$AUTOK_ROOT/otel.debug.sqlite}"
export AUTOK_LOGAL_RETENTION_HOURS="${AUTOK_LOGAL_RETENTION_HOURS:-48}"
export AUTOK_LOGAL_OTLP_PORT="${AUTOK_LOGAL_OTLP_PORT:-4318}"
export AUTOK_LOGAL_HEALTH_PORT="${AUTOK_LOGAL_HEALTH_PORT:-13133}"

if [[ "${1:-}" == "--dry-run" ]]; then
  test -f "$CONFIG_PATH"
  echo "binary=$BINARY_PATH"
  echo "config=$CONFIG_PATH"
  echo "db=$AUTOK_LOGAL_DB_PATH"
  echo "otlp_port=$AUTOK_LOGAL_OTLP_PORT"
  echo "health_port=$AUTOK_LOGAL_HEALTH_PORT"
  exit 0
fi

mkdir -p "$ROOT_DIR/bin" "$(dirname "$AUTOK_LOGAL_DB_PATH")"
cd "$ROOT_DIR"
go build -o "$BINARY_PATH" ./cmd/logal
exec "$BINARY_PATH" --config "$CONFIG_PATH" "$@"
