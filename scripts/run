#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "$0")/.." && pwd)"
AUTOK_ROOT="$(cd "$ROOT_DIR/.." && pwd)"
INVOCATION_DIR="$PWD"

absolute_path() {
	if [[ "$1" == /* ]]; then
		printf '%s\n' "$1"
	else
		printf '%s/%s\n' "$INVOCATION_DIR" "$1"
	fi
}

BINARY_PATH="${AUTOK_LOGAL_BINARY_PATH:-$(command -v logal || true)}"
if [[ -n "$BINARY_PATH" ]]; then
	BINARY_PATH="$(absolute_path "$BINARY_PATH")"
fi
CONFIG_PATH="$(absolute_path "${AUTOK_LOGAL_CONFIG_PATH:-$ROOT_DIR/config/local.yaml}")"

LOGAL_DB_PATH="$(absolute_path "${LOGAL_DB_PATH:-${AUTOK_LOGAL_DB_PATH:-$AUTOK_ROOT/otel.debug.sqlite}}")"
export LOGAL_DB_PATH
export LOGAL_RETENTION_HOURS="${LOGAL_RETENTION_HOURS:-${AUTOK_LOGAL_RETENTION_HOURS:-48}}"
export LOGAL_OTLP_GRPC_ENDPOINT="${LOGAL_OTLP_GRPC_ENDPOINT:-127.0.0.1:${LOGAL_OTLP_GRPC_PORT:-4317}}"
export LOGAL_OTLP_HTTP_ENDPOINT="${LOGAL_OTLP_HTTP_ENDPOINT:-127.0.0.1:${LOGAL_OTLP_HTTP_PORT:-${AUTOK_LOGAL_OTLP_PORT:-4318}}}"
export LOGAL_HEALTH_ENDPOINT="${LOGAL_HEALTH_ENDPOINT:-127.0.0.1:${LOGAL_HEALTH_PORT:-${AUTOK_LOGAL_HEALTH_PORT:-13133}}}"
export LOGAL_MAX_DATABASE_BYTES="${LOGAL_MAX_DATABASE_BYTES:-536870912}"
export LOGAL_MAX_IN_FLIGHT_REQUESTS="${LOGAL_MAX_IN_FLIGHT_REQUESTS:-8}"
WATCH="${AUTOK_LOGAL_WATCH:-0}"
# Each Air process owns its build output and removes only that output on exit.
# Keep this beside .tmp/air: an older runner can still remove that directory.
AIR_DIR=".tmp/air-$$"

if [[ "$WATCH" == "0" && ! -x "$BINARY_PATH" ]]; then
	echo "An installed logal is required. Install Logal or run $ROOT_DIR/scripts/install once." >&2
	echo "Set AUTOK_LOGAL_WATCH=1 only when developing Logal itself." >&2
	exit 1
fi

if [[ "${1:-}" == "--dry-run" ]]; then
	test -f "$CONFIG_PATH"
	if [[ "$WATCH" != "0" ]] && ! command -v air >/dev/null 2>&1; then
		echo "air is required; install it with: go install github.com/air-verse/air@latest" >&2
		exit 1
	fi
	if [[ "$WATCH" == "0" ]]; then
		echo "binary=$BINARY_PATH"
	else
		echo "binary=$ROOT_DIR/$AIR_DIR/logal"
	fi
	echo "config=$CONFIG_PATH"
	echo "db=$LOGAL_DB_PATH"
	echo "otlp_grpc_endpoint=$LOGAL_OTLP_GRPC_ENDPOINT"
	echo "otlp_http_endpoint=$LOGAL_OTLP_HTTP_ENDPOINT"
	echo "health_endpoint=$LOGAL_HEALTH_ENDPOINT"
	echo "max_in_flight_requests=$LOGAL_MAX_IN_FLIGHT_REQUESTS"
	echo "max_database_bytes=$LOGAL_MAX_DATABASE_BYTES"
	if [[ "$WATCH" == "0" ]]; then
		echo "runner=direct"
	else
		echo "runner=air"
	fi
	exit 0
fi

mkdir -p "$(dirname "$LOGAL_DB_PATH")"
cd "$ROOT_DIR"

if [[ "$WATCH" != "0" ]]; then
	if ! command -v air >/dev/null 2>&1; then
		echo "air is required; install it with:" >&2
		echo "  go install github.com/air-verse/air@latest" >&2
		exit 1
	fi
	exec air -color never -c "$ROOT_DIR/.air.toml" \
		-tmp_dir "$AIR_DIR" \
		-build.cmd "go build -o ./$AIR_DIR/logal ./cmd/logal" \
		-build.entrypoint "./$AIR_DIR/logal" \
		-- --config "$CONFIG_PATH" "$@"
fi

exec "$BINARY_PATH" --config "$CONFIG_PATH" "$@"
