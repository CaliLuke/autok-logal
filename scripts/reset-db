#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "$0")/.." && pwd)"
AUTOK_ROOT="$(cd "$ROOT_DIR/.." && pwd)"
INVOCATION_DIR="$PWD"

absolute_path() {
	if [[ "$1" == /* ]]; then
		printf '%s\n' "$1"
	else
		printf '%s/%s\n' "$INVOCATION_DIR" "$1"
	fi
}

DB_PATH="$(absolute_path "${AUTOK_LOGAL_DB_PATH:-$AUTOK_ROOT/otel.debug.sqlite}")"
OTLP_PORT="${AUTOK_LOGAL_OTLP_PORT:-4318}"
HEALTH_PORT="${AUTOK_LOGAL_HEALTH_PORT:-13133}"

if [[ "${1:-}" != "" && "${1:-}" != "--confirm" ]] || [[ $# -gt 1 ]]; then
	echo "usage: $0 [--confirm]" >&2
	exit 2
fi
if ! command -v lsof >/dev/null 2>&1; then
	echo "lsof is required to verify that Logal is stopped" >&2
	exit 1
fi

busy=false
for candidate in "$DB_PATH" "$DB_PATH-wal" "$DB_PATH-shm" "$DB_PATH.lock"; do
	pids="$(lsof -t -- "$candidate" 2>/dev/null || true)"
	if [[ -n "$pids" ]]; then
		echo "refusing reset: $candidate is open by PID(s): $pids" >&2
		busy=true
	fi
done
for port in "$OTLP_PORT" "$HEALTH_PORT"; do
	pids="$(lsof -nP -t -iTCP:"$port" -sTCP:LISTEN 2>/dev/null || true)"
	if [[ -n "$pids" ]]; then
		echo "refusing reset: TCP port $port is listening under PID(s): $pids" >&2
		busy=true
	fi
done
if [[ "$busy" == true ]]; then
	exit 1
fi

if [[ "${1:-}" != "--confirm" ]]; then
	echo "Logal appears stopped. Disposable database target: $DB_PATH"
	echo "Run '$0 --confirm' with the same environment to delete it."
	exit 0
fi

rm -f "$DB_PATH" "$DB_PATH-wal" "$DB_PATH-shm" "$DB_PATH.lock"
echo "Removed disposable Logal database files at $DB_PATH"
