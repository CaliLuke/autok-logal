#!/usr/bin/env bash
set -euo pipefail
ROOT_DIR="$(cd "$(dirname "$0")/.." && pwd)"
TMP_DIR="$(mktemp -d)"
trap 'rm -rf "$TMP_DIR"' EXIT
cd "$ROOT_DIR"
command -v lsof >/dev/null 2>&1 || { echo "lsof is required for collector ownership tests" >&2; exit 1; }

echo "Checking Go code..."
go vet ./...
echo "Running unit and collector contract tests with the race detector..."
LOGAL_TEST_RACE=1 go test -race -count=1 -timeout=5m ./...
echo "Building Logal..."
go build -o "$TMP_DIR/logal" ./cmd/logal
echo "Checking the standalone runner configuration..."
AUTOK_LOGAL_WATCH=0 AUTOK_LOGAL_BINARY_PATH="$TMP_DIR/logal" ./scripts/run --dry-run
echo "All verification checks passed."
